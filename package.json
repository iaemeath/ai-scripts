{
  "name": "ai-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "typecheck": "npm -w server exec tsc && npm -w web exec vue-tsc"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "workspaces": [
    "server",
    "web"
  ]
}
